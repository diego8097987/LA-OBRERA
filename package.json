{
  "name": "la-obrera-pos",
  "private": true,
  "version": "1.0.1",
  "description": "LA OBRERA Grill Asadero — Sistema POS, Cocina y Caja en tiempo real",
  "author": "LA OBRERA Grill Asadero",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "dev:electron": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','release']) fs.rmSync(p,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/utils/authValidation.test.ts src/utils/posCalculations.test.ts firestore.rules.test.ts electron/desktop.test.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:all": "npm run build && electron-builder --win nsis portable --x64",
    "release:patch": "node scripts/release-new-version.mjs patch",
    "release:minor": "node scripts/release-new-version.mjs minor",
    "serve:updates": "node scripts/serve-updates.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.laobrera.grill.pos",
    "productName": "LA OBRERA POS",
    "copyright": "Copyright © 2026 LA OBRERA Grill Asadero",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/assets/aistudio/*.html",
      "electron/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LA-OBRERA-POS-Setup-${version}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LA OBRERA POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "1034",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/diego8097987/LA-OBRERA/releases/latest/download"
      }
    ]
  }
}
